datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // Contoh Otorisasi: "USER" atau "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}